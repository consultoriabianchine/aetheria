generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  characters   Character[]
}

model Character {
  id             String             @id @default(cuid())
  accountId      String
  name           String             @unique
  position       CharacterPosition?
  stats          CharacterStats?
  skills         CharacterSkills?
  inventory      CharacterInventory?
  equipment      CharacterEquipment?
  quests         CharacterQuest[]
  account        Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt      DateTime           @default(now())
}

model CharacterPosition {
  id          String    @id @default(cuid())
  characterId String    @unique
  x           Int
  y           Int
  z           Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CharacterStats {
  id           String    @id @default(cuid())
  characterId  String    @unique
  level        Int       @default(1)
  experience   Int       @default(0)
  health       Int
  maxHealth    Int
  mana         Int
  maxMana      Int
  attack       Int
  defense      Int
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CharacterSkills {
  id          String    @id @default(cuid())
  characterId String    @unique
  sword       Int       @default(10)
  axe         Int       @default(10)
  club        Int       @default(10)
  distance    Int       @default(10)
  magic       Int       @default(10)
  defense     Int       @default(10)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model Item {
  id        String @id
  name      String
  type      String
  weight    Float  @default(0)
  stackable Boolean @default(false)
  attack    Int    @default(0)
  defense   Int    @default(0)
  image     String?
  category  String @default("outros")
  slot      String?
}

model CharacterInventory {
  id          String     @id @default(cuid())
  characterId String     @unique
  slots       Json       // ItemStack[] — { itemId, quantity } | null
  character   Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CharacterEquipment {
  id          String    @id @default(cuid())
  characterId String    @unique
  head        Json?
  armor       Json?
  legs        Json?
  boots       Json?
  weapon      Json?
  shield      Json?
  ring        Json?
  amulet      Json?
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model Monster {
  id          String  @id @default(cuid())
  templateId  String
  name        String
  level       Int
  maxHealth   Int
  attack      Int
  defense     Int
  speed       Int
  attackRange Int
  attackInterval Int
  experience  Int
  aggroRadius Int
  leashRadius Int
  loot        Json
}

model MonsterSpawn {
  id         String @id @default(cuid())
  templateId String
  x          Int
  y          Int
  z          Int
}

model Npc {
  id      String @id
  name    String
  title   String
  lines   Json
}

model Map {
  id        String    @id @default(cuid())
  name      String
  width     Int
  height    Int
  tiles     MapTile[]
}

model MapTile {
  id           String @id @default(cuid())
  mapId        String
  x            Int
  y            Int
  z            Int
  type         Int
  walkable     Boolean
  blocksVision Boolean
  map          Map    @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@unique([mapId, x, y, z])
}

model Quest {
  id          String          @id @default(cuid())
  name        String
  description String
  objectives  Json
  rewards     Json
  experience  Int
  characters  CharacterQuest[]
}

model CharacterQuest {
  id           String    @id @default(cuid())
  characterId  String
  questId      String
  status       String    @default("NOT_STARTED")
  progress     Json      @default("{}")
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  quest        Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([characterId, questId])
}

model Log {
  id        String   @id @default(cuid())
  characterId String?
  type      String
  message   String
  createdAt DateTime @default(now())
}