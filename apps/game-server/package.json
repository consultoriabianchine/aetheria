{
  "name": "aetheria-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "prisma:generate": "npm run generate -w @aetheria/database",
    "prisma:migrate": "prisma migrate dev --schema ../packages/database/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema ../packages/database/prisma/schema.prisma",
    "prisma:seed": "ts-node prisma/seed.ts",
    "hunts:analyze": "ts-node scripts/analyze-hunt-ladder.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aetheria/config": "*",
    "@aetheria/database": "*",
    "@aetheria/protocol": "*",
    "@aetheria/shared": "*",
    "@aetheria/types": "*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "bcryptjs": "^2.4.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/bcryptjs": "^2.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
