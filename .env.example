# PostgreSQL
POSTGRES_USER=aetheria
POSTGRES_PASSWORD=aetheria_dev
POSTGRES_DB=aetheria

# Aplicação
PORT=4000
HOST=0.0.0.0

# Banco (usado pelo game-server / Prisma)
DATABASE_URL=postgresql://aetheria:aetheria_dev@localhost:5432/aetheria?schema=public

# Use store em memória em vez de PostgreSQL (útil para dev sem banco)
USE_IN_MEMORY=false

# Segurança
JWT_SECRET=change_me_in_production

# Central de Comando (admin). Sem ele, endpoints admin ficam abertos em dev.
ADMIN_TOKEN=dev-admin-token

# ---------------------------------------------------------------------------
# TibiaWiki Importer (apps/tibiawiki-importer)
# ---------------------------------------------------------------------------
# Categoria padrão a importar (é lida daqui, nunca hardcoded no código).
TIBIAWIKI_CATEGORY_URL=https://www.tibiawiki.com.br/wiki/Human%C3%B3ides

# Concorrência e ritmo do scraping (seja gentil com a wiki — evita challenge do Cloudflare).
SCRAPER_CONCURRENCY=1
SCRAPER_DELAY_MS=2500
SCRAPER_TIMEOUT_MS=15000
SCRAPER_MAX_RETRIES=5
SCRAPER_MAX_REDIRECTS=5
SCRAPER_USER_AGENT=Aetheria-Importer/0.1 (projeto educacional; respeita robots.txt)

# Importa também a tabela de itens (items) além de criaturas/loot.
IMPORT_ITEMS=true

# Diretórios de saída (defaults: <app>/assets e <app>/exports/creatures — relativos ao app, não ao cwd).
#SCRAPER_ASSETS_ROOT=./assets
#SCRAPER_EXPORTS_ROOT=./exports/creatures