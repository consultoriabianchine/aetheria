{
  "name": "@aetheria/database",
  "version": "0.1.0",
  "private": true,
  "description": "Schema Prisma compartilhado (PostgreSQL) — criaturas, itens, jogadores e importação TibiaWiki",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push --accept-data-loss",
    "db:push:check": "prisma db push --skip-generate --accept-data-loss"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "^5.6.0"
  }
}