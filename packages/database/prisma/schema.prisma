generator client {
  provider = "prisma-client-js"
  output   = "../generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Contas e personagens (jogo)
// ---------------------------------------------------------------------------

model Account {
  id           String      @id @default(cuid())
  username     String      @unique
  passwordHash String
  createdAt    DateTime    @default(now())
  characters   Character[]
}

model Character {
  id             String                   @id @default(cuid())
  accountId      String
  name           String                   @unique
  archetype      String                   @default("warrior")
  gold           Int                      @default(0)
  position       CharacterPosition?
  stats          CharacterStats?
  skills         CharacterSkills?
  skillProgress  CharacterSkillProgress[]
  inventory      CharacterInventory?
  equipment      CharacterEquipment?
  quests         CharacterQuest[]
  huntProgress   HuntProgress[]
  account        Account                  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appearance     CharacterAppearance?
  outfits        CharacterOutfit[]
  createdAt      DateTime                 @default(now())

  @@index([archetype])
}

model CharacterPosition {
  id          String    @id @default(cuid())
  characterId String    @unique
  x           Int
  y           Int
  z           Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CharacterStats {
  id          String    @id @default(cuid())
  characterId String    @unique
  level       Int       @default(1)
  experience  Int       @default(0)
  health      Int
  maxHealth   Int
  mana        Int
  maxMana     Int
  attack      Int
  defense     Int
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([level])
}

model CharacterSkills {
  id          String    @id @default(cuid())
  characterId String    @unique
  melee       Int       @default(10)
  distance    Int       @default(10)
  magic       Int       @default(10)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CharacterSkillProgress {
  id          String    @id @default(cuid())
  characterId String
  skillType   String
  level       Int       @default(10)
  experience  Int       @default(0)
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, skillType])
  @@index([characterId])
}

model HuntProgress {
  id               String    @id @default(cuid())
  characterId      String
  huntId           String
  completionCount  Int       @default(0)
  firstClearAt     DateTime?
  firstClearTimeMs Int?
  bestClearTimeMs  Int?
  bestClearAt      DateTime?
  character        Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([characterId, huntId])
  @@index([characterId])
  @@map("hunt_progress")
}

model ItemDefinition {
  id                String   @id
  name              String
  description       String   @default("")
  type              String
  slot              String?
  imagePath         String?  @map("image_path")
  stackable         Boolean  @default(false)
  weight            Float    @default(0)
  category          String   @default("outros")
  sellValue         Int      @default(0) @map("sell_value")
  attackPower       Int      @default(0) @map("attack_power")
  magicPower        Int      @default(0) @map("magic_power")
  armor             Int      @default(0)
  defense           Int      @default(0)
  maxHp             Int      @default(0) @map("max_hp")
  maxMana           Int      @default(0) @map("max_mana")
  criticalChance    Float    @default(0) @map("critical_chance")
  criticalDamage    Float    @default(0) @map("critical_damage")
  accuracy          Float    @default(0)
  dodge             Float    @default(0)
  weapon            Json?
  ammo              Json?
  skillBonuses      Json?    @map("skill_bonuses")
  resistances       Json?
  requirements      Json?
  specialModifiers  Json?    @map("special_modifiers")
  enabled           Boolean  @default(true)
  sourceItemId      String?  @map("source_item_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([slot])
  @@index([enabled])
  @@map("item_definitions")
}

model CharacterInventory {
  id          String     @id @default(cuid())
  characterId String     @unique
  slots       Json
  character   Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

model CharacterEquipment {
  id          String    @id @default(cuid())
  characterId String    @unique
  helmet      Json?
  armor       Json?
  legs        Json?
  boots       Json?
  ring        Json?
  necklace    Json?
  relic       Json?
  weapon      Json?
  offhand     Json?
  ammo        Json?
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Criaturas
//
// Colunas `source_*` são preenchidas pelo importador da TibiaWiki.
// Colunas `game_*` são definidas pelo nosso jogo (podem ficar NULL até serem
// balanceadas). O game-server coalesce: game_* ?? source_* ?? default.
// ---------------------------------------------------------------------------

model CreatureDefinition {
  id                        String          @id @default(cuid())
  creature_id               Int             @unique @default(autoincrement()) @map("creature_id")
  name                      String
  slug                      String          @unique
  description               String          @default("")
  type                      String          @default("humanoid")

  // Dados importados da TibiaWiki.
  source_url                String?         @unique @map("source_url")
  source_name               String?         @map("source_name")
  source_hp                 Int?            @map("source_hp")
  source_experience         Int?            @map("source_experience")
  charms                    Int?
  difficulty                String?
  difficulty_raw            String?         @map("difficulty_raw")
  category                  String?
  image_url                 String?         @map("image_url")
  image_path                String?         @map("image_path")
  gif_url                   String?         @map("gif_url")
  gif_path                  String?         @map("gif_path")

  // Dados do nosso jogo (balanceamento).
  game_level                Int?            @map("game_level")
  game_max_health           Int?            @map("game_max_health")
  game_attack               Int?            @map("game_attack")
  game_defense              Int?            @map("game_defense")
  game_experience           Int?            @map("game_experience")
  game_speed                Int?            @map("game_speed")
  game_attack_speed         Int?            @map("game_attack_speed")
  game_attack_range         Int?            @map("game_attack_range")
  game_view_range           Int?            @map("game_view_range")
  game_chase_range          Int?            @map("game_chase_range")
  game_flee_health_percent  Int?            @default(0) @map("game_flee_health_percent")
  game_can_wander           Boolean?        @default(true) @map("game_can_wander")
  game_can_chase            Boolean?        @default(true) @map("game_can_chase")
  game_can_flee             Boolean?        @default(false) @map("game_can_flee")
  game_return_to_spawn      Boolean?        @default(true) @map("game_return_to_spawn")

  loots                     CreatureLoot[]
  sources                   CreatureSource[]
  spawns                    CreatureSpawn[]
  sprite_asset              CreatureSpriteAsset?
  animation_config          CreatureAnimationConfig?
  created_at                DateTime        @default(now()) @map("created_at")
  updated_at                DateTime        @updatedAt @map("updated_at")

  @@index([type])
  @@index([category])
  @@map("creature_definitions")
}

model CreatureSpawn {
  id                     String             @id @default(cuid())
  creature_definition_id String             @map("creature_definition_id")
  map_id                 String             @map("map_id")
  x                      Int
  y                      Int
  z                      Int
  respawn_time           Int                @default(8000) @map("respawn_time")
  max_instances          Int                @default(1) @map("max_instances")
  creature               CreatureDefinition @relation(fields: [creature_definition_id], references: [id], onDelete: Cascade)
  map                    Map                @relation(fields: [map_id], references: [id], onDelete: Cascade)

  @@index([creature_definition_id])
  @@index([map_id, x, y, z])
  @@map("creature_spawns")
}

// Loot de uma criatura. `item_name` vem da Wiki; `item_id` (opcional) liga ao
// catálogo jogável (`item_definitions`) para o drop funcionar em runtime.
model CreatureLoot {
  id          String             @id @default(cuid())
  creature_id String             @map("creature_id")
  item_id     String?            @map("item_id")
  item_name   String             @map("item_name")
  item_slug   String?            @map("item_slug")
  item_url    String?            @map("item_url")
  rarity      String             @default("UNKNOWN")
  min_quantity Int?              @map("min_quantity")
  max_quantity Int?              @map("max_quantity")
  chance      Float?
  raw_text    String?            @map("raw_text")
  creature    CreatureDefinition @relation(fields: [creature_id], references: [id], onDelete: Cascade)
  created_at  DateTime           @default(now()) @map("created_at")
  updated_at  DateTime           @updatedAt @map("updated_at")

  @@unique([creature_id, item_name])
  @@index([creature_id])
  @@index([item_id])
  @@map("creature_loot")
}

// Estado de cada fonte (URL da página) escaneada: permite saber se o conteúdo
// mudou (source_hash) e evitar reprocessamento desnecessário.
model CreatureSource {
  id             String   @id @default(cuid())
  creature_id    String   @map("creature_id")
  source_name    String   @map("source_name")
  source_url     String   @map("source_url")
  source_hash    String   @map("source_hash")
  last_scraped_at DateTime @default(now()) @map("last_scraped_at")
  creature       CreatureDefinition @relation(fields: [creature_id], references: [id], onDelete: Cascade)
  created_at     DateTime @default(now()) @map("created_at")
  updated_at     DateTime @updatedAt @map("updated_at")

  @@unique([creature_id, source_url])
  @@index([creature_id])
  @@map("creature_sources")
}

// ---------------------------------------------------------------------------
// Spritesheet + animação de criaturas (Central de Comando). O blob (BYTEA) é
// servido por GET /assets/creatures/:id; a configuração de animação é um
// JSONB validado por Zod, versionado para evitar sobrescritas concorrentes.
// ---------------------------------------------------------------------------

model CreatureSpriteAsset {
  id           String             @id @default(cuid())
  creature_id  Int                @unique @map("creature_id")
  file_name    String             @map("file_name")
  mime_type    String             @map("mime_type")
  file_size    Int                @map("file_size")
  image_width  Int                @map("image_width")
  image_height Int                @map("image_height")
  data         Bytes
  checksum     String             @map("checksum")
  uploaded_by  String?            @map("uploaded_by")
  created_at   DateTime           @default(now()) @map("created_at")
  updated_at   DateTime           @updatedAt @map("updated_at")
  creature     CreatureDefinition @relation(fields: [creature_id], references: [creature_id], onDelete: Cascade)

  @@map("creature_sprite_assets")
}

model CreatureAnimationConfig {
  id          String             @id @default(cuid())
  creature_id Int                @unique @map("creature_id")
  config      Json
  version     Int                @default(1)
  created_at  DateTime           @default(now()) @map("created_at")
  updated_at  DateTime           @updatedAt @map("updated_at")
  creature    CreatureDefinition @relation(fields: [creature_id], references: [creature_id], onDelete: Cascade)

  @@map("creature_animation_configs")
}

// ---------------------------------------------------------------------------
// Auditoria da Central de Comando (ações administrativas).
// ---------------------------------------------------------------------------

model AdminAuditLog {
  id          String   @id @default(cuid())
  actor       String
  action      String
  entity_type String   @map("entity_type")
  entity_id   String   @map("entity_id")
  before      Json?
  after       Json?
  created_at  DateTime @default(now()) @map("created_at")

  @@index([entity_type, entity_id])
  @@map("admin_audit_log")
}

// ---------------------------------------------------------------------------
// Itens importados da TibiaWiki (páginas de itens do loot).
// ---------------------------------------------------------------------------

model WikiItem {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  source_url  String?  @unique @map("source_url")
  image_url   String?  @map("image_url")
  image_path  String?  @map("image_path")
  description String?  @default("")
  created_at  DateTime @default(now()) @map("created_at")
  updated_at  DateTime @updatedAt @map("updated_at")

  @@map("items")
}

// ---------------------------------------------------------------------------
// Importação da TibiaWiki (histórico, erros e snapshots).
// ---------------------------------------------------------------------------

model ImportRun {
  id              String   @id @default(cuid())
  category_url    String   @map("category_url")
  started_at      DateTime @default(now()) @map("started_at")
  finished_at     DateTime? @map("finished_at")
  status          String   @default("RUNNING")
  total_found     Int      @default(0) @map("total_found")
  total_processed Int      @default(0) @map("total_processed")
  total_inserted  Int      @default(0) @map("total_inserted")
  total_updated   Int      @default(0) @map("total_updated")
  total_failed    Int      @default(0) @map("total_failed")
  total_skipped   Int      @default(0) @map("total_skipped")

  @@index([category_url])
  @@map("import_runs")
}

model ImportError {
  id          String   @id @default(cuid())
  source_url  String   @map("source_url")
  entity_name String?  @map("entity_name")
  error       String
  stack       String?
  created_at  DateTime @default(now()) @map("created_at")

  @@index([source_url])
  @@map("import_errors")
}

// Snapshot do HTML bruto por URL — permite corrigir o parser sem rebaixar
// todas as páginas novamente.
model ImportSnapshot {
  id           String   @id @default(cuid())
  source_url   String   @unique @map("source_url")
  content_hash String   @map("content_hash")
  html_path    String   @map("html_path")
  scraped_at   DateTime @default(now()) @map("scraped_at")

  @@index([content_hash])
  @@map("import_snapshots")
}

// ---------------------------------------------------------------------------
// Mundo, NPCs, quests e logs (jogo).
// ---------------------------------------------------------------------------

model Npc {
  id      String @id
  name    String
  title   String
  lines   Json
}

model Map {
  id        String            @id @default(cuid())
  name      String
  width     Int
  height    Int
  tiles     MapTile[]
  spawns    CreatureSpawn[]
}

model MapTile {
  id           String @id @default(cuid())
  mapId        String
  x            Int
  y            Int
  z            Int
  type         Int
  walkable     Boolean
  blocksVision Boolean
  map          Map    @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@unique([mapId, x, y, z])
}

// ---------------------------------------------------------------------------
// Hunts (Central de Comando). Começam seedadas de HUNT_CATALOG e ficam
// editáveis no admin; o motor de hunts lê desta tabela (fallback: config).
// ---------------------------------------------------------------------------

model Hunt {
  id             String   @id
  name           String
  ladderPosition Int
  suggestedLevel Int
  combatScore    Int?
  basePackSize   Int
  maxPackSize    Int
  monsters       Json
  boss           Json
  arenaId        String
  arenaWidth     Int?
  arenaHeight    Int?
  mapId          String?
  theme          Json?
  enabled        Boolean  @default(true)
  created_at     DateTime @default(now()) @map("created_at")
  updated_at     DateTime @updatedAt @map("updated_at")

  @@map("hunts")
}

// ---------------------------------------------------------------------------
// Outfits (Central de Comando). Separam SPIRIT ASSET (imagem) de ANIMATION SET
// (interpretação dos frames) — criaturas e players compartilham o motor.
// ---------------------------------------------------------------------------

model SpriteAsset {
  sprite_asset_id Int      @id @default(autoincrement()) @map("sprite_asset_id")
  file_name       String   @map("file_name")
  mime_type       String   @map("mime_type")
  file_size       Int      @map("file_size")
  image_width     Int      @map("image_width")
  image_height    Int      @map("image_height")
  data            Bytes
  checksum        String   @map("checksum")
  created_at      DateTime @default(now()) @map("created_at")
  updated_at      DateTime @updatedAt @map("updated_at")
  outfits         Outfit[]
  outfit_color_masks Outfit[] @relation("OutfitColorMask")

  @@map("sprite_assets")
}

model AnimationSet {
  animation_set_id Int      @id @default(autoincrement()) @map("animation_set_id")
  name             String
  sprite_asset_id  Int?     @map("sprite_asset_id")
  config           Json
  version          Int      @default(1)
  created_at       DateTime @default(now()) @map("created_at")
  updated_at       DateTime @updatedAt @map("updated_at")
  outfits          Outfit[]

  @@map("animation_sets")
}

model Outfit {
  id                     String      @id @default(cuid())
  outfit_id              Int         @unique @default(autoincrement()) @map("outfit_id")
  slug                   String      @unique
  name                   String
  description            String      @default("")
  sprite_asset_id        Int         @map("sprite_asset_id")
  animation_set_id       Int         @map("animation_set_id")
  color_mask_asset_id    Int?        @map("color_mask_asset_id")
  category               String      @default("default")
  body_type              String      @default("unisex")
  supports_colors        Boolean     @default(true) @map("supports_colors")
  supports_addons        Boolean     @default(false) @map("supports_addons")
  default_head_color     Int         @default(0) @map("default_head_color")
  default_primary_color  Int         @default(0) @map("default_primary_color")
  default_secondary_color Int        @default(0) @map("default_secondary_color")
  default_detail_color   Int         @default(0) @map("default_detail_color")
  available_by_default   Boolean     @default(false) @map("available_by_default")
  premium_only           Boolean     @default(false) @map("premium_only")
  enabled                Boolean     @default(true)
  published              Boolean     @default(true)
  version                Int         @default(1)
  created_at             DateTime    @default(now()) @map("created_at")
  updated_at             DateTime    @updatedAt @map("updated_at")
  sprite_asset           SpriteAsset @relation(fields: [sprite_asset_id], references: [sprite_asset_id], onDelete: Cascade)
  animation_set          AnimationSet @relation(fields: [animation_set_id], references: [animation_set_id], onDelete: Cascade)
  color_mask_asset       SpriteAsset? @relation("OutfitColorMask", fields: [color_mask_asset_id], references: [sprite_asset_id], onDelete: SetNull)

  @@index([category])
  @@index([sprite_asset_id])
  @@index([animation_set_id])
  @@map("outfits")
}

model CharacterAppearance {
  id              String    @id @default(cuid())
  character_id    String    @unique @map("character_id")
  outfit_id       Int       @map("outfit_id")
  addon_mask      Int       @default(0) @map("addon_mask")
  head_color      Int       @default(0) @map("head_color")
  primary_color   Int       @default(0) @map("primary_color")
  secondary_color Int       @default(0) @map("secondary_color")
  detail_color    Int       @default(0) @map("detail_color")
  updated_at      DateTime  @updatedAt @map("updated_at")
  character       Character @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@map("character_appearance")
}

model CharacterOutfit {
  id           String    @id @default(cuid())
  character_id String    @map("character_id")
  outfit_id    Int       @map("outfit_id")
  addon_mask   Int       @default(0) @map("addon_mask")
  unlocked_at  DateTime  @default(now()) @map("unlocked_at")
  source       String    @default("admin")
  character    Character @relation(fields: [character_id], references: [id], onDelete: Cascade)

  @@unique([character_id, outfit_id])
  @@map("character_outfits")
}

model Quest {
  id          String          @id @default(cuid())
  name        String
  description String
  objectives  Json
  rewards     Json
  experience  Int
  characters  CharacterQuest[]
}

model CharacterQuest {
  id           String    @id @default(cuid())
  characterId  String
  questId      String
  status       String    @default("NOT_STARTED")
  progress     Json      @default("{}")
  character    Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  quest        Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([characterId, questId])
}

model Log {
  id          String   @id @default(cuid())
  characterId String?
  type        String
  message     String
  createdAt   DateTime @default(now())
}
