{
  "name": "aetheria",
  "version": "0.1.0",
  "private": true,
  "description": "Aetheria Online — base de um MMORPG 2D multiplayer original (Angular + Phaser + NestJS + PostgreSQL)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:packages && npm run build:server && npm run build:web",
    "build:packages": "npm run build -w @aetheria/types -w @aetheria/protocol -w @aetheria/config -w @aetheria/shared",
    "build:server": "npm run build -w aetheria-server",
    "build:web": "npm run build -w aetheria-web",
    "dev:server": "npm run start:dev -w aetheria-server",
    "dev:web": "npm run start -w aetheria-web",
    "db:migrate": "npm run prisma:migrate -w aetheria-server",
    "db:seed": "npm run prisma:seed -w aetheria-server"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@6.19.3": true
  }
}
