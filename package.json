{
  "name": "aetheria",
  "version": "0.1.0",
  "private": true,
  "description": "Aetheria Online — base de um MMORPG 2D multiplayer original (Angular + Phaser + NestJS + PostgreSQL)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:packages && npm run build:server && npm run build:web && npm run build:importer",
    "build:packages": "npm run build -w @aetheria/types -w @aetheria/protocol -w @aetheria/config -w @aetheria/shared -w @aetheria/database",
    "build:server": "npm run build -w aetheria-server",
    "build:web": "npm run build -w aetheria-web",
    "build:importer": "npm run build -w tibiawiki-importer",
    "dev:server": "npm run start:dev -w aetheria-server",
    "dev:web": "npm run start -w aetheria-web",
    "db:generate": "npm run generate -w @aetheria/database",
    "db:migrate": "npm run migrate:dev -w @aetheria/database",
    "db:migrate:deploy": "npm run migrate:deploy -w @aetheria/database",
    "db:push": "npm run db:push -w @aetheria/database",
    "db:seed": "npm run prisma:seed -w aetheria-server",
    "importer": "node apps/tibiawiki-importer/dist/main.js",
    "importer:dry": "node apps/tibiawiki-importer/dist/main.js --dry-run",
    "importer:test": "node apps/tibiawiki-importer/dist/main.js --dry-run --limit=3",
    "importer:inspect": "node apps/tibiawiki-importer/dist/main.js --inspect",
    "importer:integration": "node apps/tibiawiki-importer/dist/main.js --dry-run --limit=1 --verbose",
    "importer:test-unit": "npm run test -w tibiawiki-importer",
    "server:test": "npm run test -w aetheria-server",
    "test": "npm run server:test && npm run importer:test-unit",
    "postinstall": "npm run db:generate"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "prisma@6.19.3": true
  }
}
